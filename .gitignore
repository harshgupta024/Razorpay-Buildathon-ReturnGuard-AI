# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Environment files
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data files (raw data can be large)
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.json
data/raw/*.zip
data/raw/*.gz

# Processed data contents (keep directory structures/READMEs)
data/processed/*
!data/processed/README.md
data/splits/*
!data/splits/README.md
!data/splits/split_metadata.json

# Model artifacts
models/*.pkl
models/*.joblib
models/*.json

# Database
*.db
*.sqlite
*.sqlite3

# Reports (generated)
reports/*.png
reports/*.jpg

# Node modules
node_modules/
dist/

# Logs
*.log

# Coverage
.coverage
htmlcov/
.pytest_cache/

# Docker
*.tar

# Jupyter
.ipynb_checkpoints/
