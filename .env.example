# Environment Variables — ReturnGuard AI
# Copy this file to .env and fill in the values

# ============================================================
# Application Settings
# ============================================================
APP_NAME=ReturnGuard AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ============================================================
# Backend Settings
# ============================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Database Settings
# ============================================================
DATABASE_URL=sqlite:///./data/returnguard.db

# ============================================================
# ML Settings
# ============================================================
MODEL_PATH=./models/
RANDOM_SEED=42
MODEL_VERSION=returnguard-v1

# ============================================================
# Business Cost Parameters (Configurable Assumptions)
# These are NOT actual merchant costs — adjust for your use case
# ============================================================
AVG_ORDER_VALUE=3000
AVG_MARGIN_PCT=0.30
RETURN_SHIPPING_COST=150
HANDLING_COST=100
RESTOCKING_LOSS_PCT=0.10
MANUAL_REVIEW_COST=50
ESTIMATED_CONVERSION_LOSS=200

# ============================================================
# Risk Thresholds
# ============================================================
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_HIGH=0.70

# ============================================================
# Dataset (if authentication required for download)
# ============================================================
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# ============================================================
# Frontend Settings
# ============================================================
VITE_API_BASE_URL=http://localhost:8000
